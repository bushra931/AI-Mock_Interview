# Server
PORT=8000
FRONTEND_URL=http://localhost:3000

# SMTP (use any SMTP provider like Gmail, SendGrid, Brevo, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="CareerPilot AI <noreply@careerpilot.ai>"

# If SMTP is not set, the server falls back to console logging
# the verification link (useful for dev)
